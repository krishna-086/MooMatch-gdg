# Copy to .env and fill in a real key. Never commit .env.

# Google Gemini API key, from https://aistudio.google.com/
# Required - the /api/chat endpoint returns 500 without it.
GEMINI_API_KEY=

# Port for the Express server. Optional, defaults to 3000.
PORT=3000

# Comma-separated list of frontend origins allowed to call this API.
# Optional. Defaults to http://localhost:5173 and https://moomatch.netlify.app.
# CORS_ORIGINS=http://localhost:5173,https://moomatch.netlify.app
