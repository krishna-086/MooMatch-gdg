# Copy to .env and fill in your Firebase values. Never commit .env.
# Every variable must start with VITE_ or Vite will not expose it to the app.
# Restart the dev server after changing anything here.

# --- Service URLs -------------------------------------------------------------
# Chat backend (backend/). Required for the chatbot widget.
VITE_API_URL=http://localhost:3000

# Disease prediction API (ml-backend/). Optional - if left unset, the app calls
# the deployed Cloud Run service instead of a local server.
VITE_ML_API_URL=http://localhost:5000

# --- Firebase -----------------------------------------------------------------
# From Firebase Console > Project settings > Your apps > SDK setup and configuration.
# Required for the dashboard and marketplace, which read and write Firestore.
# These are public by design and get baked into the browser bundle; protect your
# data with Firestore security rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
